POSTGRES_PASSWORD=troque-esta-senha
SECRET_KEY=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
ENVIRONMENT=development
POSITRON_LOGIN=
POSITRON_PASSWORD=

# Geoapify: chave exclusiva do backend, nunca use prefixo VITE_.
GEOAPIFY_API_KEY=
ROUTES_GEOCODER_PROVIDER=geoapify
ROUTES_ROUTER_PROVIDER=geoapify
# URLs legadas nao sao usadas quando o provedor selecionado e Geoapify.
ROUTES_GEOCODER_URL=https://nominatim.openstreetmap.org
ROUTES_ROUTER_URL=
ROUTES_TIMEOUT_SECONDS=15
ROUTES_MIN_INTERVAL_SECONDS=1

# Geocodificacao: chave somente no backend. Ajuste limites ao contrato do provedor.
GEOCODING_PRIMARY_ENABLED=true
GEOCODING_REQUIRE_NEIGHBORHOOD_MATCH=true
GEOCODING_CONFLICT_METERS=200
GEOCODING_CACHE_SECONDS=2592000
GEOCODING_FAILURE_CACHE_SECONDS=300


# Sankhya OAuth (somente backend)
SANKHYA_BASE_URL=https://api.sankhya.com.br
SANKHYA_CLIENT_ID=
SANKHYA_CLIENT_SECRET=
SANKHYA_TOKEN=
SANKHYA_TIMEOUT_SECONDS=20
